# GRIDGUARD AI — Local Environment Configuration Example
# Copy to .env if overriding defaults; application works out-of-the-box without .env.

# FastAPI / Uvicorn host binding
GRIDGUARD_HOST=127.0.0.1
GRIDGUARD_PORT=8000

# Vite frontend dev server port (optional development mode only)
VITE_PORT=5173

# Matplotlib headless backend for Windows / CI environments
MPLBACKEND=Agg
