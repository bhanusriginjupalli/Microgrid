{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GRIDGUARD AI Canonical Saved Episode Schema",
  "version": "1.0.0",
  "type": "object",
  "required": ["episode_id", "schema_version", "metadata", "metrics", "steps"],
  "properties": {
    "episode_id": {"type": "string", "minLength": 1},
    "schema_version": {"type": "string", "const": "1.0.0"},
    "metadata": {
      "type": "object",
      "required": [
        "episode_id",
        "schema_version",
        "experiment_id",
        "algorithm",
        "controller_name",
        "controller_group",
        "track",
        "mode",
        "scenario_id",
        "training_seed",
        "evaluation_seed",
        "selected_checkpoint_episode",
        "episode_length",
        "timestep_minutes",
        "start_timestamp",
        "completion_status",
        "enable_safety_shield",
        "adequacy_fallback",
        "trace_path",
        "summary_path"
      ],
      "properties": {
        "episode_id": {"type": "string"},
        "schema_version": {"type": "string"},
        "experiment_id": {"type": "string"},
        "algorithm": {
          "type": "string",
          "enum": ["IPPO", "MAPPO_MATCHED", "HAPPO", "Greedy EMS", "Rule-Based EMS", "Lookahead Heuristic EMS"]
        },
        "controller_name": {"type": "string"},
        "controller_group": {"type": "string", "enum": ["Learned MARL", "Heuristic Baseline"]},
        "track": {"type": "string", "enum": ["track_a_intrinsic", "track_b_shielded", "track_c_hybrid"]},
        "mode": {"type": "string", "enum": ["Intrinsic", "Shielded", "Hybrid (+Fallback)", "Heuristic"]},
        "scenario_id": {"type": "string", "pattern": "^scenario_h[1-6]$"},
        "training_seed": {"type": ["integer", "null"]},
        "evaluation_seed": {"type": "integer"},
        "selected_checkpoint_episode": {"type": ["integer", "null"]},
        "episode_length": {"type": "integer", "const": 96},
        "timestep_minutes": {"type": "number", "const": 15.0},
        "start_timestamp": {"type": ["string", "null"]},
        "completion_status": {"type": "string", "enum": ["completed", "partial", "failed"]},
        "enable_safety_shield": {"type": "boolean"},
        "adequacy_fallback": {"type": "boolean"},
        "checkpoint_path": {"type": ["string", "null"]},
        "trace_path": {"type": "string"},
        "summary_path": {"type": "string"}
      }
    },
    "metrics": {
      "type": "object",
      "required": [
        "reward",
        "true_social_cost_usd",
        "operating_cost_usd",
        "grid_import_cost_usd",
        "grid_export_revenue_usd",
        "fuel_cost_usd",
        "startup_wear_cost_usd",
        "critical_ens_mwh",
        "flexible_ens_mwh",
        "other_ens_mwh",
        "total_ens_mwh",
        "critical_reliability_pct",
        "total_reliability_pct",
        "renewable_curtailment_mwh",
        "battery_throughput_mwh",
        "battery_degradation_cost_usd",
        "terminal_battery_soc_pct",
        "fuel_consumed_l",
        "generator_operating_hours",
        "generator_startup_count",
        "voltage_violation_steps",
        "power_flow_failures",
        "power_flow_converged_pct",
        "unshielded_feasible_pct",
        "boundary_clipping_count",
        "emergency_override_count",
        "supply_adequacy_intervention_count",
        "fallback_intervention_steps"
      ]
    },
    "steps": {
      "type": "array",
      "minItems": 96,
      "maxItems": 96,
      "items": {
        "type": "object",
        "required": [
          "step_idx",
          "hour",
          "timestamp_label",
          "observations",
          "proposed_actions",
          "executed_actions",
          "solar_available_mw",
          "solar_mw",
          "wind_available_mw",
          "wind_mw",
          "renewable_curtailment_mw",
          "battery_soc_pct",
          "battery_mw",
          "generator_state",
          "generator_mw",
          "step_fuel_l",
          "grid_connected",
          "grid_available",
          "grid_import_mw",
          "nominal_critical_mw",
          "nominal_flexible_mw",
          "nominal_other_mw",
          "served_critical_mw",
          "served_flexible_mw",
          "served_other_mw",
          "shed_critical_mw",
          "shed_flexible_mw",
          "shed_other_mw",
          "voltages_pu",
          "reward",
          "reward_breakdown",
          "step_operating_cost_usd",
          "step_social_cost_usd",
          "shield_events",
          "fallback_events",
          "scenario_events",
          "converged"
        ]
      }
    }
  }
}
